# =============================================================================
# robotics-obsidian-paper-wiki-organizer — .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# CRITICAL: Never commit PDFs or private vault data
# ---------------------------------------------------------------------------
*.pdf
*.PDF

# Generated Obsidian vault (never commit your actual Publications folder)
Publications/
/output/
/vault/

# Metadata CSV/JSON generated by the tool (contain private paper data)
rename_log.csv
papers_catalog.csv
papers_catalog.json
low_confidence_review.csv
duplicate_candidates.csv
run_log_*.json
inventory.csv
inventory.json
low_confidence.csv

# Local config overrides (paths are machine-specific)
config.yaml
config.local.yaml
config.*.yaml
!examples/config.example.yaml

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/
*.pyo

# Virtual environments
.venv/
venv/
env/
ENV/
.env/

# Distribution / packaging
MANIFEST
.installed.cfg
lib/
lib64/
sdist/
wheels/
*.egg-link
*.dist-info/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
*.cover
coverage.xml
nosetests.xml
pytest.ini.bak

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# ---------------------------------------------------------------------------
# IDE / editor
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# JetBrains
*.iml
*.iws
*.ipr
out/

# ---------------------------------------------------------------------------
# Obsidian workspace (personal, not project files)
# ---------------------------------------------------------------------------
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/graph.json
.obsidian/starred.json
.obsidian/recent-files-obmit.json
.obsidian/plugins/
.obsidian/themes/

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
$RECYCLE.BIN/
